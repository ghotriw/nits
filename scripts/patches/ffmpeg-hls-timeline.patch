+/* Where the packets of segment seq_no are expected to start, in AV_TIME_BASE units on the timestamps of the first
+ * segment read: the start the playlist's durations give it. AV_NOPTS_VALUE if not known. */
+static int64_t expected_segment_start(HLSContext *c, struct playlist *pls, int64_t seq_no)
+{
+    int64_t pos, idx = seq_no - pls->start_seq_no;
+
+    if (c->first_timestamp == AV_NOPTS_VALUE || pls->ts_offset == AV_NOPTS_VALUE ||
+        idx < 0 || idx > pls->n_segments)
+        return AV_NOPTS_VALUE;
+    pos = c->first_timestamp + pls->ts_offset;
+    for (int64_t i = 0; i < idx; i++)
+        pos += pls->segments[i]->duration;
+    return pos;
+}
+
+/* After an EXT-X-DISCONTINUITY the timestamps may start again (an inserted advertisement, a splice) or jump. The seek
+ * of this demuxer finds the segment by the playlist's durations and then drops packets until their timestamps reach
+ * its start there, which the restarted ones never do, so the packets of such a segment are moved onto the playlist's
+ * timeline: by the difference of where the playlist puts the segment and the timestamp of its first packet, taken
+ * (see dts_anchor) at the first packet after a seek or the first that jumps after the segment. A difference of less
+ * than half a target duration (a server that keeps its timestamps) is not taken. */
+static void hls_move_to_timeline(HLSContext *c, struct playlist *pls, AVPacket *pkt)
+{
+    AVRational tb;
+    int64_t ref, ts, threshold;
+    int64_t *last;
+
+    if (!pls->has_discont)
+        return;
+    /* A packet with no DTS is moved too, by its PTS. */
+    ref = pkt->dts != AV_NOPTS_VALUE ? pkt->dts : pkt->pts;
+    if (ref == AV_NOPTS_VALUE)
+        return;
+    tb = pls->ctx->streams[pkt->stream_index]->time_base;
+    ts = av_rescale_q(ref, tb, AV_TIME_BASE_Q);
+    threshold = FFMAX(AV_TIME_BASE, pls->target_duration / 2);
+    /* The jump is that of a stream against its own last packet: the packets of the segment before may still come out
+     * of the subdemuxer, and those of another stream are not on the same timestamps. */
+    last = pkt->stream_index < HLS_TRACKED_STREAMS ? &pls->last_raw_ts[pkt->stream_index] : NULL;
+
+    if (pls->dts_anchor &&
+        (pls->dts_anchor == 2 ||
+         (last && *last != AV_NOPTS_VALUE && FFABS(ts - *last) > 2 * AV_TIME_BASE))) {
+        int64_t expected = expected_segment_start(c, pls, pls->dts_anchor_seq);
+
+        /* Where the playlist puts the segment is not known (a live window that moved on, a playlist that has not set
+         * its offset yet): the offset it has stays. */
+        if (expected != AV_NOPTS_VALUE) {
+            int64_t diff = expected - ts;
+
+            pls->dts_offset = FFABS(diff) > threshold ? diff : 0;
+            av_log(c->ctx, AV_LOG_DEBUG, "Playlist %d: segment %"PRId64" expected at %"PRId64", packet at %"PRId64
+                   ": offset %"PRId64"\n", pls->index, pls->dts_anchor_seq, expected, ts, pls->dts_offset);
+        }
+        pls->dts_anchor = 0;
+    }
+    if (last)
+        *last = ts;
+
+    if (pls->dts_offset) {
+        int64_t offset = av_rescale_q(pls->dts_offset, AV_TIME_BASE_Q, tb);
+
+        /* A packet of the segment before that comes out of the subdemuxer after the offset was taken (the h264 parser
+         * holds the last pictures until more data arrives) is on timestamps of its own, not of the new segment: it
+         * would land far off the playlist's timeline, and stays where it was. */
+        if (c->first_timestamp != AV_NOPTS_VALUE) {
+            int64_t end = c->first_timestamp, margin = 2 * threshold;
+
+            for (int i = 0; i < pls->n_segments; i++)
+                end += pls->segments[i]->duration;
+            if (ts + pls->dts_offset < c->first_timestamp - margin || ts + pls->dts_offset > end + margin)
+                return;
+        }
+        if (pkt->dts != AV_NOPTS_VALUE)
+            pkt->dts += offset;
+        if (pkt->pts != AV_NOPTS_VALUE)
+            pkt->pts += offset;
+    }
+}
+
