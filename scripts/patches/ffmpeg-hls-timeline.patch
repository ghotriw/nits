                     (pls->ts_offset == AV_NOPTS_VALUE ||
                      (!c->first_timestamp_locked &&
@@ -3127,6 +3266,12 @@ static int hls_read_seek(AVFormatContext *s, int stream_index,
         }
 
         pls->last_seq_no = pls->cur_seq_no;
+
+        /* The first packet read from here sets the offset of the timeline its segment is on. */
+        pls->dts_offset = 0;
+        reset_last_raw_ts(pls);
+        pls->dts_anchor = pls->has_discont && !pls->is_subtitle ? 2 : 0;
+        pls->dts_anchor_seq = pls->cur_seq_no;
     }
 
