+
+static void free_extradata_slots(struct playlist *pls)
+{
+    for (int i = 0; i < HLS_TRACKED_STREAMS; i++) {
+        av_freep(&pls->cur_extradata[i]);
+        av_freep(&pls->new_extradata[i]);
+        pls->cur_extradata_size[i] = pls->new_extradata_size[i] = 0;
+    }
+    pls->extradata_started = 0;
 }
 
+static int same_extradata(const uint8_t *a, int a_size, const uint8_t *b, int b_size)
+{
+    return a_size == b_size && (!a_size || !memcmp(a, b, a_size));
+}
+
+static int store_extradata(uint8_t **dst, int *dst_size, const uint8_t *src, int size)
+{
+    uint8_t *copy = NULL;
+
+    if (size > 0) {
+        copy = av_memdup(src, size);
+        if (!copy)
+            return AVERROR(ENOMEM);
+    }
+    av_free(*dst);
+    *dst = copy;
+    *dst_size = size > 0 ? size : 0;
+    return 0;
+}
+
+/* The extradata of the streams in the init section just read (a moov) goes to the next key frame of each stream that
+ * it differs for, as AV_PKT_DATA_NEW_EXTRADATA: the mov sub-demuxer takes the first moov only. The init section is
+ * parsed by a mov demuxer of its own, over a copy of its bytes. Only for playlists with more than one init section
+ * (EXT-X-MAP renewed), and streams the init section has in the same order and kind as the sub-demuxer's. */
+static void hls_take_init_extradata(struct playlist *pls)
+{
+    AVFormatContext *probe = NULL;
+    AVIOContext *io = NULL;
+    uint8_t *copy = NULL;
+    const AVInputFormat *mov = av_find_input_format("mov");
+    const AVFormatContext *ctx = pls->ctx;
+
+    if (pls->n_init_sections < 2 || !mov || !ctx || !ctx->nb_streams || !pls->init_sec_data_len ||
+        !ctx->iformat || !strstr(ctx->iformat->name, "mov"))
+        return;
+
+    copy = av_memdup(pls->init_sec_buf, pls->init_sec_data_len);
+    if (!copy)
+        return;
+    io = avio_alloc_context(copy, pls->init_sec_data_len, 0, NULL, NULL, NULL, NULL);
+    if (!io) {
+        av_free(copy);
+        return;
+    }
+    probe = avformat_alloc_context();
+    if (!probe)
+        goto end;
+    probe->pb = io;
+    probe->flags |= AVFMT_FLAG_CUSTOM_IO;
+    if (avformat_open_input(&probe, "", mov, NULL) < 0) {
+        probe = NULL;
+        goto end;
+    }
+
+    if (!pls->extradata_started) {
+        /* The streams as the first init section made them. */
+        for (unsigned i = 0; i < ctx->nb_streams && i < HLS_TRACKED_STREAMS; i++) {
+            const AVCodecParameters *par = ctx->streams[i]->codecpar;
+            store_extradata(&pls->cur_extradata[i], &pls->cur_extradata_size[i], par->extradata, par->extradata_size);
+        }
+        pls->extradata_started = 1;
+    }
+    for (unsigned i = 0; i < probe->nb_streams && i < ctx->nb_streams && i < HLS_TRACKED_STREAMS; i++) {
+        const AVCodecParameters *par = probe->streams[i]->codecpar;
+        const AVCodecParameters *own = ctx->streams[i]->codecpar;
+
+        if (par->codec_type != own->codec_type || par->codec_id != own->codec_id || par->extradata_size <= 0)
+            continue;
+        if (!pls->extradata_forced &&
+            same_extradata(par->extradata, par->extradata_size, pls->cur_extradata[i], pls->cur_extradata_size[i]))
+            continue;
+        if (store_extradata(&pls->new_extradata[i], &pls->new_extradata_size[i], par->extradata, par->extradata_size) < 0)
+            continue;
+        store_extradata(&pls->cur_extradata[i], &pls->cur_extradata_size[i], par->extradata, par->extradata_size);
+    }
+    pls->extradata_forced = 0;
+
+end:
+    if (probe)
+        avformat_close_input(&probe);
+    av_freep(&io->buffer);
+    avio_context_free(&io);
+}
+
+/* The next key frame of a stream whose extradata changed with the init section carries the new one. */
+static void hls_attach_new_extradata(struct playlist *pls, AVPacket *pkt)
+{
+    int i = pkt->stream_index;
+    uint8_t *side;
+
+    if (i < 0 || i >= HLS_TRACKED_STREAMS || !pls->new_extradata[i] || !(pkt->flags & AV_PKT_FLAG_KEY))
+        return;
+    side = av_packet_new_side_data(pkt, AV_PKT_DATA_NEW_EXTRADATA, pls->new_extradata_size[i]);
+    if (!side)
+        return;
+    memcpy(side, pls->new_extradata[i], pls->new_extradata_size[i]);
+    av_freep(&pls->new_extradata[i]);
+    pls->new_extradata_size[i] = 0;
+}
+
 static int update_init_section(struct playlist *pls, struct segment *seg)
 {
     static const int max_init_section_size = 1024*1024;
@@ -1689,6 +1813,7 @@
     pls->cur_init_section = seg->init_section;
     pls->init_sec_data_len = ret;
     pls->init_sec_buf_read_offset = 0;
+    hls_take_init_extradata(pls);
 
     /* spec says audio elementary streams do not have media initialization
      * sections, so there should be no ID3 timestamps */
@@ -3093,6 +3218,7 @@
             }
         }
 
+        hls_attach_new_extradata(pls, pls->pkt);
         av_packet_move_ref(pkt, pls->pkt);
